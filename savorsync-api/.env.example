# Copy this file to savorsync-api/.env for local development.
# On Render, add the same names under Environment. Never commit real values.

# Required
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# Can be the same value as MONGODB_URI: a "/?" in the string is rewritten to "/savorsync_db?",
# so recipes get their own database on the same cluster.
RECIPE_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# Required when NODE_ENV=production (the API will not start without it). Any long random string.
JWT_SECRET=

NODE_ENV=development
PORT=3001

# Number of proxies in front of the API, so rate limits see each visitor's own IP.
# 2 = Netlify's /api proxy plus Render's load balancer. Use 0 when running locally without a proxy.
TRUST_PROXY_HOPS=2

# Optional: AI features (swaps, "Ask about this dish", Cook with AI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: playlists in "Cook with music"
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Needed for photo uploads (avatars, posts, review photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
